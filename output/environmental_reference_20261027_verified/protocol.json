      "pacific_nw": [
        [
          14,
          22,
          92,
          102
        ]
      ]
    },
    "pnw_air_plan": "calibration/pnw_vertical_20261027/plan.json",
    "reference_plans": [
      "calibration/pnw_transport_20261027/plan.json",
      "calibration/circulation_audit_20261026/plan.json"
    ],
    "archives": {
