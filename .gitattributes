# Packed climate fields must remain byte-exact, including Windows checkouts.
*.csv whitespace=cr-at-eol
atlases/*/data/**/*.bin binary
atlases/*/data/**/*.gz binary
# Source copies and metadata carry byte hashes in the portable data packets.
atlases/release.json -text
atlases/*/data/**/*.json -text
atlases/*/data/**/*.csv -text whitespace=cr-at-eol

# The evidence release hashes this generated page as an exact publication asset.
atlases/earth_evidence/index.html -text

# Frozen evidence plans and audit receipts must keep their published identities.
calibration/earth_components_20261105/*.json -text
output/earth_components_20261105/**/*.json -text
output/earth_components_20261105/**/*.csv -text
calibration/low_input_yields_20261105/*.json -text
output/low_input_yields_20261105/**/*.json -text

# Recovered r44 models retain their recorded file identities across checkouts.
calibration/local_accuracy_20261023/r44_params.json -text
calibration/earth_correction_r44_20261107/**/*.json -text
calibration/earth_correction_r44_20261107/reconstruction_plan.json -text
output/earth_correction_r44_20261107/**/*.json -text
