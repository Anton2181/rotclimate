# Packed climate fields must remain byte-exact, including Windows checkouts.
*.csv whitespace=cr-at-eol
atlases/*/data/**/*.bin binary
atlases/*/data/**/*.gz binary
# Source copies and metadata carry byte hashes in the portable data packets.
atlases/release.json -text
atlases/*/data/**/*.json -text
atlases/*/data/**/*.csv -text whitespace=cr-at-eol
